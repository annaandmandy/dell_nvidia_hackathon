# Local vLLM on the GB10 (NemoClaw managed, Qwen3.6-35B-A3B-NVFP4). Final hackathon run must stay local.
MERIDIAN_LLM_URL=http://localhost:8000/v1/chat/completions
MERIDIAN_LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
# Laptop-only fallback: MERIDIAN_LLM_URL=https://api.openai.com/v1/chat/completions, MERIDIAN_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Meeting monitor (/vision, /voice) — local too: vision uses the same Qwen3.6 VLM,
# ASR uses Whisper on vLLM (scripts/start_whisper.sh), TTS is Chrome speechSynthesis.
# MERIDIAN_VISION_URL=http://localhost:8000/v1/chat/completions
# MERIDIAN_ASR_MODEL=whisper
# WHISPER_LANGUAGE=en
NIM_ASR_URL=http://localhost:5001/v1/audio/transcriptions

SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional trusted identity mappings for policy-aware DMs.
# Comma-separated Slack user IDs / channel IDs.
MERIDIAN_A_USER_IDS=
MERIDIAN_B_USER_IDS=
MERIDIAN_A_DM_CHANNEL_IDS=
MERIDIAN_B_DM_CHANNEL_IDS=
MERIDIAN_JOINT_CHANNEL_IDS=

# GB10/NIM aliases are also supported by app.py:
# NIM_LLM_URL=http://localhost:8000/v1/chat/completions
# MERGEOPS_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
