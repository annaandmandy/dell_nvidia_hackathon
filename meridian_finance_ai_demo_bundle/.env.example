# Local OpenAI-compatible generation endpoints
PRIMARY_LLM_URL=http://127.0.0.1:8000/v1
PRIMARY_LLM_MODEL=local-qwen-primary
FALLBACK_LLM_URL=http://127.0.0.1:8001/v1
FALLBACK_LLM_MODEL=local-nemotron-fallback

ASR_BACKEND=nemotron_streaming
ASR_MODEL_PATH=/models/nemotron-asr-streaming
VISION_BACKEND=local_multimodal
VISION_MODEL_PATH=/models/local-vision
EMBEDDING_BACKEND=nemotron_embed
EMBEDDING_MODEL_PATH=/models/nemotron-embed
SAFETY_BACKEND=nemotron_content_safety
SAFETY_MODEL_PATH=/models/nemotron-content-safety
TTS_BACKEND=local_tts
TTS_MODEL_PATH=/models/local-tts

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
DEMO_REPLAY_MODE=true
LOG_PRIVATE_CONTENT=false
REQUIRE_SIGNED_JOINT_DISCLOSURES=true
ALLOW_CLOUD_MODEL_FALLBACK=false
MAX_PRIVACY_BUDGET_PER_SESSION=5
